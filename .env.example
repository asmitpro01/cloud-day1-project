# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Every variable is validated at boot (src/env/schema.ts).
# Never commit .env. Use TEST-mode keys everywhere except your production deploy.
# ─────────────────────────────────────────────────────────────────────────────

# App URL, no trailing slash. Used for auth callbacks and email links. Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Payment Page URL for the landing "Pre-order" button (optional; falls back to the waitlist).
NEXT_PUBLIC_PREORDER_URL=

# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection string (Neon "pooled" / Supabase transaction pooler on port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Optional direct connection for migrations (Neon sets DATABASE_URL_UNPOOLED automatically on Vercel).
DATABASE_URL_UNPOOLED=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth (optional; the button is hidden when unset). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get admin access once verified.
ADMIN_EMAILS=
# Header your host sets with the real client IP (x-forwarded-for on Vercel, cf-connecting-ip behind Cloudflare).
TRUSTED_IP_HEADER=x-forwarded-for

# ── Phone OTP ───────────────────────────────────────────────────────────────
# msg91 | twilio | console (dev only: prints codes to the terminal) | none (hides phone login)
OTP_PROVIDER=console
# MSG91: needs a DLT-approved OTP template. See README → "MSG91 setup".
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio: TWILIO_FROM is your E.164 sender number or a Messaging Service SID (MG…).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Email ───────────────────────────────────────────────────────────────────
# resend | console (dev only: writes emails to .outbox/)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Use onboarding@resend.dev until your domain is verified in Resend.
EMAIL_FROM=Desi SaaS Kit <onboarding@resend.dev>
EMAIL_REPLY_TO=

# ── Payments ────────────────────────────────────────────────────────────────
# razorpay | fake (dev/e2e only: offline simulator) | none (hides billing)
PAYMENTS_PROVIDER=fake
# Dashboard → Account & Settings → API keys. rzp_test_ keys are required outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → your endpoint <APP_URL>/api/webhooks/razorpay → secret.
RAZORPAY_WEBHOOK_SECRET=

# ── Tests ───────────────────────────────────────────────────────────────────
# Separate database for integration tests (it is wiped). docker compose provides one.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
