{
  "name": "desi-saas-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "email:dev": "email dev --dir src/emails --port 3001",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "plans:sync": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env scripts/sync-plans.ts",
    "bootstrap": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env scripts/bootstrap.ts",
    "admin:grant": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.3",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  }
}
